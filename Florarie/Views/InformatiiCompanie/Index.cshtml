@{
    ViewBag.Title = "Index";
}

<center>
    <h1>Despre compania noastră, Bucuria Florilor</h1>
    &nbsp;&nbsp;&nbsp;
    &nbsp;&nbsp;&nbsp;
    &nbsp;&nbsp;&nbsp;
    &nbsp;&nbsp;&nbsp;
