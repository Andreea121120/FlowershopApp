<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/ajax")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/js/bootstrap.min.js" integrity="sha384-Atwg2Pkwv9vp0ygtn1JAojH0nYbwNJLPhwyoVbhoPwBhjQPR5VtM2+xf0Uwh9KtT" crossorigin="anonymous"></script>

    <style>
        .btn-primary {
            background-color: #c277a1;
            border: none;
        }

        footer {
            background-color: #c277a1;
        }
    </style>


    <style>
        .dropdown-item:hover,
        .dropdown-item:focus {
            background-color: #c277a1;
        }
    </style>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        .container.body-content {
            flex: 1;
        }

        footer {
            background-color: #c277a1;
            height: 150px;
            text-align: center;
            color: white;
        }
    </style>
    <style>
        .menu-shift {
            margin-left: 160px;
        }
    </style>
    <link rel="stylesheet" href="~/style/Buttons.css" />
    <link rel="stylesheet" href="~/style/SideBar.css" />


</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="sidebar" id="sidebar">

            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <div class="user-info">
                <p>Bine ai venit, <strong>@Session["UserName"]</strong></p>
                <p>&nbsp;</p>
                <div class="list-group">

                    <a href="@Url.Action("Index", "CosCumparaturi")" class="list-group-item list-group-item-action list-group-item-light">vezi cosul de cumparaturi</a>
                    <a href="@Url.Action("Index", "ComenziClient")" class="list-group-item list-group-item-action list-group-item-light">Comenzile mele</a>
                    <a href="@Url.Action("VerificaSiRedirectioneaza", "Clienti")" class="list-group-item list-group-item-action list-group-item-light">
                        vezi pagina de profil
                    </a>


                </div>
                <p>&nbsp;</p>

                <form action="@Url.Action("Deconectare", "ProfilUtilizator")" method="post">
                    <button type="submit">Deconectare</button>
                </form>
            </div>
        </div>
        <button class="toggle-btn" id="toggleBtn" style="background-color:transparent">
            <img src="/Img/user (1).png" alt="User Image" style="width: 50px; height: 50px;">
        </button>



        <script>
            document.getElementById('toggleBtn').addEventListener('click', function () {
                document.getElementById('sidebar').classList.toggle('open');
            });
        </script>
    }


    <nav class="navbar bg-body-tertiary" style="background-color: #c277a1;">
        <div class="container-fluid">
            <a>@Html.ActionLink("EDEN FLORAL", "Index", "Home", null, new { @class = "navbar-brand mx-auto fw-bold text-white fs-2" })</a>
        </div>
    </nav>

    <nav class="navbar navbar-expand-lg bg-body-tertiary" style="background-color: #c277a1; " ;">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-center menu-shift" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                    <a>@Html.ActionLink("Home", "Index", "Home", new { lengh = 4 }, new { @class = "nav-link text-white" })</a>
                    <a>@Html.ActionLink("Cadouri", "Cadouri", "Produse", null, new { @class = "nav-link text-white" })</a>
                    <a>@Html.ActionLink("Buchete", "Buchete", "Produse", null, new { @class = "nav-link text-white" })</a>
                    <a>@Html.ActionLink("Plante", "Plante", "Produse", null, new { @class = "nav-link text-white" })</a>
                    <a>@Html.ActionLink("Aranjamente", "Aranjamente", "Produse", null, new { @class = "nav-link text-white" })</a>
                </div>
            </div>
        </div>

        <a class="icon-link" href="@Url.Action("Index", "CosCumparaturi")">

            <img src="~/Content/Imagini/cos_icon.png" alt="Cos de cumparaturi" style="width: 24px; height: 24px;" />
        </a>

        <div class="dropdown">
            <a class="btn dropdown-toggle" href="#" role="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" style="background-color: transparent;">
                <img src="~/Content/Imagini/logare_icon.png" class="bi bi-person-circle fs-3 me-3" style="height: 25px; margin-left: 60px;" alt="Dropdown Icon" />
            </a>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                <li><a class="dropdown-item" href="@Url.Action("Autentificare", "Autentificare")">Autentificare</a></li>
                <li><a class="dropdown-item" href="@Url.Action("Adauga", "Inregistrare")">Inregistrare</a></li>
            </ul>
        </div>

    </nav>

    <div class="container body-content">
        @RenderBody()
    </div>

    <footer class="py-3" style="height: 150px;">
        <div class="container-fluid text-center text-white">
            <p>&copy; 2025 Floraria Noastra</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>


