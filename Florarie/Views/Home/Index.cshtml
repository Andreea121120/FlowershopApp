@{
    ViewBag.Title = "Home Page";
}


<main>
    <main>
        <div style="display: flex; justify-content: space-between; justify-content: center; align-items: flex-start; gap: 20px;">
            <div style="flex: 0 0 30%; padding-right: 20px; text-align: center; margin-top:40px">
                <p>
                    Echipa Noastră, înțelege importanța fiecărui moment special. Florile sunt cel mai frumos mod de a transmite emoții autentice. De aceea, vă oferim posibilitatea de a comanda flori online și de a le trimite direct la ușa celor dragi, cu livrare rapidă în toată țara.
                </p>
                <p>
                    Fiecare buchet este realizat cu grijă și cu atenție, pentru a oferi un cadou deosebit, care să impresioneze și să rămână în amintirea celor dragi.
                </p>
                <p>
                    Alegeți dintr-o gamă variată de flori și aranjamente florale, disponibile online, și lăsați-ne să transformăm orice moment într-o amintire de neuitat.
                </p>
                <p>
                    Pentru mai multe detalii, accesați:
                    <a href="/InformatiiCompanie/Index" style="color: #c277a1; font-style: italic;">Informații suplimentare</a>
                </p>

            </div>

            <div style="flex: 0 0 70%; display: flex; justify-content: center;">
                <div class="container h-100 d-flex align-items-center justify-content-center m-5 mx-auto">
                    <div id="carouselExampleIndicators" class="carousel slide" style="width: 100%; height: 500px;">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="~/Content/Imagini/buchet_carousel.jpg" class="d-block w-100" alt="..." style="object-fit: cover; height: 100%;">
                            </div>
                            <div class="carousel-item">
                                <img src="~/Content/Imagini/planta_carousel.jpg" class="d-block w-100" alt="..." style="object-fit: cover; height: 100%;">
                            </div>
                            <div class="carousel-item">
                                <img src="~/Content/Imagini/aranjament_carousel.jpg" class="d-block w-100" alt="..." style="object-fit: cover; height: 100%;">
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </main>



</main>