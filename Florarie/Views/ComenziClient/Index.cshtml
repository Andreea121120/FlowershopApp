@model IEnumerable<Florarie.DAL.Comenzi>

@{
    ViewBag.Title = "Index";
}
<link href="~/style/card.css" rel="stylesheet" type="text/css" />
<div style="text-align: center">
    <h2>Comenzile mele </h2>
</div>

<div class="table-container">
    <table class="produse-mele-table">
        <tr>
            <th>
               Id comanda
            </th>
            <th>
                Data comanda
            </th>
            <th>
                Total
            </th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdComanda)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataComanda)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Total)
                </td>

            </tr>
        }

    </table>
    <p>&nbsp;</p>
    <p>&nbsp</p>
    </div>
